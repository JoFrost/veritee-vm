{
  # We only expose the caddy admin endpoint to the guest-attestation
  # by listening only on the corresponding network interface.
  # Caddy's private control API lets the guest helper read its TLS root CA.
  admin caddy-in-constrained-attestation-generator-network:2019
}


attestation.strategy-runner.midnight.io {
	bind 0.0.0.0

	root * /srv

	handle_path /tee_attestation* {
		reverse_proxy attestation:8000
	}

	file_server

	{{ATTESTATION_TLS}}
}

api.strategy-runner.midnight.io {
	bind 0.0.0.0

	{{APP_TLS}}

	handle /.well-known/strategy-runner-key.json {
		root * /srv
		file_server
	}

	reverse_proxy app:80
}

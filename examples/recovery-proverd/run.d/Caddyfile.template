{
  # Caddy's private control API lets the guest helper read its TLS root CA.
  admin caddy-in-constrained-attestation-generator-network:2019
}


attestation-endpoint.api.recovery-proverd.midnight.io {
	# Bind to all network interfaces
	bind 0.0.0.0

	root * /srv

	handle_path /tee_attestation* {
		reverse_proxy attestation:8000
	}

	file_server

	{{ATTESTATION_TLS}}
}

api.recovery-proverd.midnight.io {
	# Bind to all network interfaces
	bind 0.0.0.0

	{{APP_TLS}}

	# Reverse proxy to the app. recovery-proverd serves plaintext HTTP on :8443
	# (-insecure-plaintext); Caddy terminates TLS at the edge.
	reverse_proxy app:8443
}

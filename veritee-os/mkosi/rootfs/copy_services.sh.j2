#!/bin/bash

{% if azureSnp %}
cp services/azure-provisioning.service $BUILDROOT/etc/systemd/system/azure-provisioning.service
cp services/attestation_server.service $BUILDROOT/etc/systemd/system/attestation_server.service
# Enable at boot (WantedBy alone does not enable; create the multi-user wants link).
mkdir -p "$BUILDROOT/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/azure-provisioning.service \
  "$BUILDROOT/etc/systemd/system/multi-user.target.wants/azure-provisioning.service"
ln -sf /etc/systemd/system/attestation_server.service \
  "$BUILDROOT/etc/systemd/system/multi-user.target.wants/attestation_server.service"
{% endif %}

{% if debug %}
cp services/start_ssh.service $BUILDROOT/etc/systemd/system/start_ssh.service
cp services/restart-serial-console.service $BUILDROOT/etc/systemd/system/restart-serial-console.service
mkdir -p "$BUILDROOT/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/start_ssh.service \
  "$BUILDROOT/etc/systemd/system/multi-user.target.wants/start_ssh.service"
ln -sf /etc/systemd/system/restart-serial-console.service \
  "$BUILDROOT/etc/systemd/system/multi-user.target.wants/restart-serial-console.service"
mkdir -p "$BUILDROOT/etc/systemd/system/measured-setup.service.d"
cp services/measured-setup-allow-pcr15-failure.conf \
  "$BUILDROOT/etc/systemd/system/measured-setup.service.d/allow-pcr15-failure.conf"
{% endif %}

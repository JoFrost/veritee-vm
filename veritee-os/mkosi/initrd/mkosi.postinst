#!/bin/sh

echo "Removing Systemd GPT auto generator"
rm $BUILDROOT/usr/lib/systemd/system-generators/systemd-gpt-auto-generator

mkdir -p $BUILDROOT/sysroot

# Overrides /run/systemd/generator/sysroot.mount which is automatically generated by systemd-fstab-generator
cat > $BUILDROOT/etc/systemd/system/sysroot.mount <<EOF
[Unit]
Documentation=man:fstab(5) man:systemd-fstab-generator(8)
SourcePath=/proc/cmdline
Before=initrd-root-fs.target
Requires=tmpfs_sysroot.service

[Mount]
What=/run/mytmpfs/root.img
Where=/sysroot
Options=ro
EOF

cat > $BUILDROOT/etc/systemd/system/tmpfs_sysroot.service <<EOF
[Unit]
Description=Load /dev/mapper/root to RAM tmpfs
Before=sysroot.mount
After=blockdev@dev-mapper-root.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'set -e; mkdir /run/mytmpfs; mount -t tmpfs none /run/mytmpfs; dd if=/dev/mapper/root of=/run/mytmpfs/root.img'
EOF

# Azure does not mount those files anymore at boot. Without this, the VM will refuse to boot entierly.
mkdir -p $BUILDROOT/etc/systemd/system/initrd-root-fs.target.requires
ln -sf ../sysroot.mount $BUILDROOT/etc/systemd/system/initrd-root-fs.target.requires/sysroot.mount

rm -f "$BUILDROOT/var/log/alternatives.log" \
      "$BUILDROOT/var/log/dpkg.log" \
      "$BUILDROOT/var/log/apt/history.log" \
      "$BUILDROOT/var/log/apt/term.log" 2>/dev/null || true

rm -rf "$BUILDROOT/var/log/"* 2>/dev/null || true

rm -f "$BUILDROOT/etc/ld.so.cache" 2>/dev/null || true
rm -rf "$BUILDROOT/var/cache/ldconfig" 2>/dev/null || true

rm -f "$BUILDROOT/var/lib/systemd/random-seed" 2>/dev/null || true
echo "a1a5c43c21c06ea50191dc38cbf6eb6d" > "$BUILDROOT/etc/machine-id"
chmod 0644 "$BUILDROOT/etc/machine-id"
rm -f "$BUILDROOT/var/lib/dbus/machine-id" 2>/dev/null || true
ln -sf /etc/machine-id "$BUILDROOT/var/lib/dbus/machine-id" 2>/dev/null || true

if command -v touch >/dev/null 2>&1; then
  find "$BUILDROOT" -xdev -print0 | xargs -0 touch -h -d @0 2>/dev/null || true
fi
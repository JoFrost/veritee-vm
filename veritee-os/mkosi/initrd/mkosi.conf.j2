[Distribution]
{% if azureSnp %}
Distribution=ubuntu
Release=jammy
Repositories=main,universe,restricted
{% else %}
Distribution=debian
Release=bookworm
Repositories=contrib,non-free,non-free-firmware
{% endif %}
Architecture=x86-64

[Build]
ExtraSearchPaths=../../systemd/build

[Content]
MakeInitrd=yes

{% if debug %}
RootPassword=root
{% endif %}

[Output]
Format=cpio
ManifestFormat = json

[Content]
Packages=systemd=249.11-0ubuntu3.17
         udev=249.11-0ubuntu3.17
         dmsetup=2:1.02.175-2.1ubuntu5
         kmod=29-1ubuntu1
         tpm2-tools=5.2-1build1
         